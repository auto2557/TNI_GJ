generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model applicant {
  id           Int              @id @default(autoincrement())
  firstName    String           @db.VarChar(255)
  lastName     String           @db.VarChar(255)
  nickname     String?          @db.VarChar(100)
  email        String           @unique(map: "email") @db.VarChar(255)
  paymentProof String?          @db.Text
  createdAt    DateTime         @default(now()) @db.DateTime(0)
  status       applicant_status @default(Pending)
  userId       Int              @unique(map: "userId")
  user         user             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_applicant_user")
  teammember   teammember?
}

model team {
  id         Int          @id @default(autoincrement())
  name       String       @unique(map: "Team_name_key")
  createdAt  DateTime     @default(now()) @db.DateTime(0)
  teammember teammember[]
}

model teammember {
  id          Int       @id @default(autoincrement())
  applicantId Int       @unique(map: "TeamMember_applicantId_key")
  teamId      Int
  role        String
  createdAt   DateTime  @default(now()) @db.DateTime(0)
  applicant   applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade, map: "TeamMember_applicantId_fkey")
  team        team      @relation(fields: [teamId], references: [id], onDelete: Cascade, map: "TeamMember_teamId_fkey")

  @@index([teamId], map: "TeamMember_teamId_idx")
}

model user {
  id           Int        @id @default(autoincrement())
  username     String     @unique(map: "username") @db.VarChar(30)
  passwordHash String     @db.VarChar(255)
  role         String     @default("USER") @db.VarChar(20)
  createdAt    DateTime   @default(now())
  applicant    applicant?
}

enum applicant_status {
  Pending
  Approved
  Rejected
}
